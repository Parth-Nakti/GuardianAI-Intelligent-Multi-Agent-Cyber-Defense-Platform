# SentinelAI Configuration

# LLM Provider: openai | gemini | groq | ollama | mock
LLM_PROVIDER=mock

# API Keys (only needed for respective provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM Model (provider-specific)
LLM_MODEL=

# Ollama settings (if using ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Upload limits (in bytes)
MAX_UPLOAD_SIZE=52428800

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
